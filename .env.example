# ---------- Core ----------
NODE_ENV=development
# Your Vercel production URL, or your tunnel URL in development.
APP_URL=https://catalog-pilot-beige.vercel.app

# ---------- Database (Neon) ----------
# Pooled connection — used by the app. Note the `-pooler` in the host.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/catalogpilot?sslmode=require&connect_timeout=15
# Direct connection — used by `prisma migrate` only. No `-pooler`.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/catalogpilot?sslmode=require

# ---------- Secrets ----------
# 32-byte key, base64 encoded:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Signs OAuth state tokens. Any long random string.
APP_SECRET=

# ---------- Shopify ----------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations
SHOPIFY_API_VERSION=2026-07

# ---------- Google ----------
# Signing in with Google is hidden until Google finishes verifying the app.
# The spreadsheets scope is "sensitive", so until then the consent screen only
# admits manually approved testers. Set to true once verification is granted.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://catalog-pilot-beige.vercel.app/api/auth/google/callback

# Shared sheets (optional, but this is how merchants connect without Google
# app verification). Create a service account in Google Cloud Console, enable
# the Sheets API, and download its JSON key.
#   EMAIL = the service account address merchants share their sheet with
#   KEY   = that JSON file base64-encoded, or just its private_key PEM
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# ---------- Jobs ----------
# On Vercel: set CRON_SECRET in the project's environment variables. Vercel
# sends it automatically as `Authorization: Bearer <CRON_SECRET>` when it
# invokes a cron job, and /api/jobs/run accepts it.
CRON_SECRET=
# Only needed to trigger the job runner yourself (curl, an external scheduler,
# or a non-Vercel host). Leave empty if you rely on Vercel Cron alone.
JOB_RUNNER_SECRET=

# ---------- Notifications (optional) ----------
# Without SMTP the app works fully; it simply sends no email.
SMTP_URL=
NOTIFICATION_FROM_EMAIL=notifications@example.com
