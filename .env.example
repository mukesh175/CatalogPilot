# ---------- Core ----------
NODE_ENV=development
APP_URL=https://your-tunnel-domain.example.com
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catalogpilot?schema=public

# 32-byte key, base64 encoded. Generate: node scripts/generate-key.mjs
ENCRYPTION_KEY=
# Signs internal session cookies / state tokens (any long random string)
APP_SECRET=

# ---------- Shopify ----------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations
SHOPIFY_API_VERSION=2026-07

# ---------- Google ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-tunnel-domain.example.com/api/auth/google/callback

# ---------- Jobs ----------
# Shared secret required by the cron/worker trigger endpoints
JOB_RUNNER_SECRET=

# ---------- Notifications (optional) ----------
SMTP_URL=
NOTIFICATION_FROM_EMAIL=notifications@example.com
